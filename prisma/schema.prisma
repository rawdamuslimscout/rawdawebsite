// Prisma schema for فوج روضة الفيحاء
//
// Target: Supabase Postgres. This file only defines the schema —
// connect it yourself by setting DATABASE_URL / DIRECT_URL in .env
// (see .env.example) and running `npx prisma migrate dev` then
// `npx prisma db seed`. Nothing here performs a connection.
//
// Supabase note: pooled connections (pgbouncer, port 6543) don't
// support Prisma's advisory locks used during migrations, so this
// schema follows Supabase's documented pattern of a pooled
// DATABASE_URL for the app + a direct DIRECT_URL for migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------
// Auth — single/small set of admin users who can edit site content.
// ---------------------------------------------------------------
model Admin {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  /// Bumped on logout / password change; sessions carrying an older value are rejected.
  sessionVersion Int     @default(0)
  createdAt    DateTime @default(now())
}

// Fixed-window counters for rate limiting (works on serverless: state lives in the DB).
model RateLimit {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime
  @@index([resetAt])
}

// Append-only security / admin audit trail. Never stores passwords, tokens or secrets.
model AuditLog {
  id        String   @id @default(cuid())
  action    String
  adminId   String?
  resource  String?
  targetId  String?
  ip        String?
  meta      String   @default("")
  createdAt DateTime @default(now())
  @@index([createdAt])
  @@index([action, createdAt])
}

// ---------------------------------------------------------------
// Homepage content
// ---------------------------------------------------------------
model SiteSettings {
  id              String @id @default("singleton")
  name            String
  tagline         String
  parentOrg       String
  instagramUrl    String
  contactPhone    String
  contactLocation String
  joinIntro       String @db.Text
  aboutImageIds   String @default("[]")
}

model SiteStat {
  id    String @id @default(cuid())
  value String
  label String
  order Int    @default(0)
}

model ScoutStage {
  id          String @id @default(cuid())
  slug        String @unique
  title       String
  ageRange    String
  description String @db.Text
  icon        String
  imageUrl    String @default("")
  fileUrl     String @default("")
  order       Int    @default(0)
  leaders     ScoutLeader[]
  orgNodes    OrgNode[]
}

model ScoutLeader {
  id        String     @id @default(cuid())
  stageId   String
  stage     ScoutStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  name      String
  rank      String
  role      String
  bio       String     @db.Text
  photoUrl  String     @default("")
  order     Int        @default(0)
}

model Activity {
  id          String @id @default(cuid())
  slug        String @unique
  title       String
  description String @db.Text
  icon        String
  order       Int    @default(0)
}

model EventItem {
  id          String @id @default(cuid())
  title       String
  date        String
  location    String
  groupName   String
  description String @db.Text
  order       Int    @default(0)
}

model Camp {
  id       String @id @default(cuid())
  title    String
  year     String
  location String
  summary  String @db.Text
  order    Int    @default(0)
}

// ---------------------------------------------------------------
// خريطة «أماكن من رحلتنا الكشفية» — one row per place on the public map.
// Only rows with isPublished = true and real coordinates are ever shown.
// participants = 0 means "unknown" and is never displayed.
// ---------------------------------------------------------------
model ScoutPlace {
  id           String    @id @default(cuid())
  title        String
  category     String // camps | trips | training | service | events
  locationName String
  latitude     Float
  longitude    Float
  dateText     String    @default("")
  description  String    @default("") @db.Text
  participants Int       @default(0)
  imageUrl     String    @default("")
  newsId       String? // optional link to a news item that holds the full story
  news         NewsItem? @relation(fields: [newsId], references: [id], onDelete: SetNull)
  isPublished  Boolean   @default(true)
  order        Int       @default(0)

  @@index([isPublished, order])
}

model Milestone {
  id          String @id @default(cuid())
  year        String
  title       String
  description String @db.Text
  order       Int    @default(0)
}

model ValueItem {
  id    String @id @default(cuid())
  slug  String @unique
  title String
  order Int    @default(0)
}

model NewsItem {
  id       String @id @default(cuid())
  title    String
  category String
  date     String
  excerpt  String @db.Text
  imageUrl String @default("")
  imageUrls String @default("[]")
  order    Int    @default(0)
  places   ScoutPlace[]
}

model GalleryItem {
  id       String @id @default(cuid())
  title    String
  category String // camps | activities | trips | training | events
  size     String // large | medium | small
  imageUrl String @default("")
  order    Int    @default(0)
}

model BlogPost {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  category  String
  date      String
  author    String
  excerpt   String   @db.Text
  content   String   @db.Text // paragraphs separated by blank lines
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LibraryResource {
  id          String @id @default(cuid())
  title       String
  category    String // guides | badges | forms | songs
  description String @db.Text
  fileType    String // PDF | DOCX
  fileUrl     String
  order       Int    @default(0)
}

// ---------------------------------------------------------------
// "Join Us" page — pricing + weekly schedule per stage/group
// ---------------------------------------------------------------
model JoinPricing {
  id          String @id @default(cuid())
  title       String
  price       String
  period      String
  description String @db.Text
  order       Int    @default(0)
}

model JoinSchedule {
  id       String @id @default(cuid())
  stage    String // e.g. "البراعم"
  ageRange String
  day      String // e.g. "السبت"
  time     String // e.g. "٣:٠٠ – ٥:٠٠ م"
  location String
  leaders  Int    @default(1)
  order    Int    @default(0)
}

// ---------------------------------------------------------------
// الأسئلة الشائعة
// ---------------------------------------------------------------
model Faq {
  id          String  @id @default(dbgenerated("gen_random_uuid()::text"))
  question    String
  answer      String  @db.Text
  category    String  @default("about")
  order       Int     @default(0)
  isPublished Boolean @default(true)

  @@index([isPublished, category, order])
}

// ---------------------------------------------------------------
// الهيكل التنظيمي — nodes form a tree; people are separate records
// linked to nodes through assignments (one person, many positions).
// Only records explicitly marked as published are ever shown publicly.
// ---------------------------------------------------------------
model OrgNode {
  id          String   @id @default(cuid())
  parentId    String?
  parent      OrgNode? @relation("OrgTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    OrgNode[] @relation("OrgTree")
  kind        String   // association | governorate | troop | dean | council | unit | other
  title       String
  description String   @default("") @db.Text
  logoUrl     String   @default("")
  stageId     String?  // optional link to an existing ScoutStage (for unit nodes)
  stage       ScoutStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)
  order       Int      @default(0)
  isPublished Boolean  @default(false)
  assignments OrgAssignment[]

  @@index([parentId, order])
}

model OrgPerson {
  id             String   @id @default(cuid())
  fullName       String
  photoUrl       String   @default("")
  rank           String   @default("")
  section        String   @default("")
  education      String   @default("")
  fieldOfStudy   String   @default("")
  occupation     String   @default("")
  bio            String   @default("") @db.Text
  isPublic       Boolean  @default(false)
  showEducation  Boolean  @default(true)
  showOccupation Boolean  @default(true)
  assignments    OrgAssignment[]
  qualifications OrgQualification[]
  createdAt      DateTime @default(now())
}

model OrgAssignment {
  id               String    @id @default(cuid())
  nodeId           String
  node             OrgNode   @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  personId         String
  person           OrgPerson @relation(fields: [personId], references: [id], onDelete: Cascade)
  title            String
  responsibilities String    @default("") @db.Text
  order            Int       @default(0)
  isPublished      Boolean   @default(true)

  @@unique([nodeId, personId, title])
  @@index([nodeId, order])
}

model OrgQualification {
  id       String    @id @default(cuid())
  personId String
  person   OrgPerson @relation(fields: [personId], references: [id], onDelete: Cascade)
  kind     String    // course | education
  title    String
  issuer   String    @default("")
  year     String    @default("")
  order    Int       @default(0)

  @@index([personId, order])
}
