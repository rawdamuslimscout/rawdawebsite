# Copy to .env and fill in. Never commit real values.

# Supabase Postgres — pooled (port 6543, ?pgbouncer=true) for the app,
# direct (port 5432) for `prisma migrate deploy` / seeding.
DATABASE_URL=
DIRECT_URL=

# Random string, at least 32 characters (e.g. `openssl rand -hex 32`).
SESSION_SECRET=

# Supabase Storage (uploads). The service-role key is server-only.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional, defaults to "uploads".
SUPABASE_STORAGE_BUCKET=

# Used by `pnpm db:seed` (creates the admin once) and `pnpm admin:reset-password`.
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=
